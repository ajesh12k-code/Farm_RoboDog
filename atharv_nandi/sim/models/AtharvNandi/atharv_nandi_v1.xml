<mujoco model="AtharvNandi">
  <!-- FROZEN COPY (WP0 regression oracle, MVP-SPEC 3.1) of atharv_nandi.xml at feat/nandi-pilot 1bc5a5d.
       Never edit it: tests/test_model_layout.py compares the live robot (qpos/actuator names, RL observation)
       against this file. WP1 edits atharv_nandi.xml only (joint-less additions). -->
  <!-- Physics alignment v1 (orchard target, 2026-11-17). Every physical number below carries a tag:
       MEASURED (headless run, tools/physics/*), CITED (source), DERIVED (arithmetic shown) or ASSUMED.
       Mass budget (DERIVED, kg): trunk body 15.45 + gantry carriage 0.35 = 15.8; dorsal basket 0.9;
       arm chain after the carriage 1.6; 6 legs x 2.25 = 13.5. Total 31.8.
       qpos layout is frozen: robot qpos[0:32], crop_item_1 at qpos[32:39]; ctrl order == qpos[7:32]. -->
  <compiler angle="radian" autolimits="true"/>
  <!-- cone elliptic + impratio 10: friction no longer drives normal penetration; same cost as pyramidal
       (MEASURED 45 vs 46 us/step, contact audit c98754d). timestep 0.002 is the default; 0.004 only via
       NANDI_DT (farm_scene) for STANDING / stop-and-shoot scans: walking at 0.004 is not gated (MEASURED 10 kg flat
       walk 2 calf-floor ticks, turn up to 10.1 mm foot penetration; 0 ticks at 0.002; review F6). -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <!-- Joint damping 1.5 Nm.s/rad: ASSUMED. Armature 0.02 kg.m^2: ASSUMED.
         TODO(armature): set to rotor_inertia * N^2 once the AK80-64 datasheet rotor inertia is obtained. -->
    <joint damping="1.5" armature="0.02"/>
    <!-- Friction 0.8 / 0.02 / 0.01: ASSUMED dry orchard soil against rubber. -->
    <geom friction="0.8 0.02 0.01" rgba="0.2 0.55 0.25 1"/>
    <!-- Mass-only sub-geoms (motors, battery, electronics): no collision, so the contact set is unchanged. -->
    <default class="mass_only">
      <geom contype="0" conaffinity="0" group="3" rgba="0.1 0.1 0.12 1"/>
    </default>
    <!-- Leg actuator class: AK80-64 (CITED: rated 48 Nm, peak 120 Nm, rated speed ~4.2-5.0 rad/s;
         store.tmotor.com goods-1202, robotshop cubemars ak80-64, 2026-11-17). Position servo kp 300 / kv 6:
         removes the 34-48 mm tripod sag of kp 120 (MEASURED mass-load M14) and is above the kp 240 that held a
         3 m mast at 10 deg nose-up (MEASURED mounting H). forcerange +-100: peak derated from 120 (DERIVED).
         The 5 rad/s speed cap is a target rate limit in controllers/tripod_gait.py (a position actuator
         cannot cap velocity); the 48 Nm continuous limit is reported (RMS), not clamped.
         Upgrade path: kp 480 / kv 8 (saturates 10-38 % of samples at fr 48, MEASURED mass-load). -->
    <default class="leg_motor">
      <position kp="300" kv="6" ctrlrange="-2.8 2.8" forcerange="-100 100"/>
    </default>
    <!-- Finger pads: stiff, high-priority contact so a pinched crop does not creep out of the grip.
         With MuJoCo's default soft contact (solimp 0.9 0.95) friction is regularised and a 7 cm crop
         slid down through the pads at ~8 cm/s regardless of grip force, falling out mid-carry.
         priority=1 makes these params win over the crop's; solimp 0.995 cuts the creep to < 1 mm/s. -->
    <default class="finger_pad">
      <geom priority="1" solref="0.005 1" solimp="0.995 0.999 0.001" friction="1.2 0.02 0.01"/>
    </default>
    <!-- Basket floor and walls: stiff contact so a resting crop does not sink or creep (contact audit). -->
    <default class="basket">
      <geom solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.85 0.65 0.2 1"/>
    </default>
    <!-- Invisible mount / sensor sites (alpha 0). -->
    <default class="mount">
      <site size="0.006" rgba="1 1 1 0"/>
    </default>
  </default>

  <asset>
    <texture type="2d" name="farm_soil" builtin="checker" width="512" height="512" rgb1="0.24 0.18 0.12" rgb2="0.28 0.21 0.14"/>
    <material name="soil_mat" texture="farm_soil" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.95 0.95 0.9"/>
    <!-- solref 0.01 1: hard orchard ground (MEASURED 0.70 mm standing penetration with elliptic cones). -->
    <geom name="floor" type="plane" size="25 25 0.1" material="soil_mat" solref="0.01 1"/>

    <!-- Uneven Farm Terrain Test Bumps -->
    <geom name="ridge_1" type="box" pos="1.4 0 0.02" size="0.15 1.5 0.02" rgba="0.3 0.22 0.15 1"/>
    <geom name="ridge_2" type="box" pos="2.2 0 0.03" size="0.18 1.5 0.03" rgba="0.3 0.22 0.15 1"/>

    <!-- Main Hexapod Chassis FIRST so qpos[0..6] is trunk root -->
    <body name="trunk" pos="0 0 0.34">
      <freejoint name="root"/>
      <!-- Frame / shell 5.0 kg (ASSUMED), the collision box of the trunk. -->
      <geom name="trunk_geom" type="box" size="0.34 0.14 0.05" mass="5.0" rgba="0.14 0.28 0.16 1"/>
      <!-- 6 hip-abduction motors on the trunk at the hip mounts, 0.85 kg each (CITED AK80-64 ~850 g; listings
           disagree, 1.5 kg also seen). 6 x 0.85 = 5.1 kg (DERIVED). -->
      <geom name="FR_hipabd_motor" class="mass_only" type="cylinder" pos="0.26 -0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="FL_hipabd_motor" class="mass_only" type="cylinder" pos="0.26 0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="MR_hipabd_motor" class="mass_only" type="cylinder" pos="0.0 -0.105 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="ML_hipabd_motor" class="mass_only" type="cylinder" pos="0.0 0.105 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="RR_hipabd_motor" class="mass_only" type="cylinder" pos="-0.26 -0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="RL_hipabd_motor" class="mass_only" type="cylinder" pos="-0.26 0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <!-- Battery 3.2 kg: 500 Wh Li-ion at ~155 Wh/kg pack (ASSUMED), low and forward so the home CoM sits over
           the 6-foot support centroid (spec: |CoM x - centroid x| <= 0.010 m). -->
      <geom name="battery" class="mass_only" type="box" pos="0.06 0 -0.025" size="0.10 0.07 0.022" mass="3.2"/>
      <!-- Compute + electronics 1.5 kg (ASSUMED). -->
      <geom name="electronics" class="mass_only" type="box" pos="0.10 0 0.0" size="0.07 0.06 0.02" mass="1.5"/>

      <!-- Mount sites (body trunk). B owns the ratings table (controllers/load_model.py). -->
      <site name="imu" class="mount" pos="0 0 0"/>
      <site name="head_cam" class="mount" pos="0.35 0 0.06"/>
      <site name="mast_base" class="mount" pos="0.03 0 0.05"/>
      <site name="front_mount" class="mount" pos="0.34 0 0"/>
      <site name="rear_mount" class="mount" pos="-0.34 0 0"/>
      <site name="tow_dock" class="mount" pos="-0.34 0 -0.03"/>

      <!-- Full-Length Top Cargo Basket (0.64m long x 0.24m wide, clear of all 6 legs), 0.9 kg -->
      <body name="dorsal_basket" pos="0 0 0.055">
        <geom name="basket_floor" class="basket" type="box" pos="0 0 0" size="0.32 0.12 0.006" mass="0.4"/>
        <geom name="basket_front" class="basket" type="box" pos="0.314 0 0.035" size="0.006 0.12 0.035" mass="0.1"/>
        <geom name="basket_rear" class="basket" type="box" pos="-0.314 0 0.035" size="0.006 0.12 0.035" mass="0.1"/>
        <geom name="basket_left_wall" class="basket" type="box" pos="0 0.114 0.035" size="0.32 0.006 0.035" mass="0.15"/>
        <geom name="basket_right_wall" class="basket" type="box" pos="0 -0.114 0.035" size="0.32 0.006 0.035" mass="0.15"/>
        <!-- Payload CoM reference: trunk z 0.096 = floor top 0.061 + half of the 0.07 wall (DERIVED). -->
        <site name="basket_payload" class="mount" pos="0 0 0.041"/>
      </body>

      <!-- Elevated Dorsal Gantry Rail spanning full length above the top basket.
           Rail + pillars 0.65 kg + carriage 0.35 kg = 1.0 kg (ASSUMED). -->
      <geom name="gantry_pillar_front" type="box" pos="0.314 0 0.11" size="0.012 0.025 0.025" mass="0.1" rgba="0.35 0.37 0.4 1"/>
      <geom name="gantry_pillar_rear" type="box" pos="-0.314 0 0.11" size="0.012 0.025 0.025" mass="0.1" rgba="0.35 0.37 0.4 1"/>
      <geom name="gantry_rail" type="box" pos="0 0 0.135" size="0.326 0.022 0.01" mass="0.45" rgba="0.4 0.42 0.45 1"/>

      <!-- Sliding Carriage + Extended Ground-Reaching 4-DOF Harvesting Arm (0.34m + 0.34m).
           Arm chain after the carriage 1.6 kg (ASSUMED, heavier servos): turret 0.75 (yaw motor + shoulder
           motor, so the shoulder motor mass is not in the upper arm), upper arm 0.35, forearm 0.30 (incl. the
           wrist servo), wrist/palm 0.15, fingers 2 x 0.025.
           No body gravcomp: MuJoCo applies body gravcomp to every DoF above the body, including the root
           freejoint (actuatorgravcomp only reroutes the arm hinges), which gave the chassis +8.3 N of free lift
           and hid the arm's tipping moment (review F1, MEASURED). Gravity is fed forward instead as a
           position-target offset tau_g / kp (arm_ik_solver.gravity_offsets via mj_rne, used by harvest_logic),
           so the arm motors carry the full gravity torque and /nandi/joint_states effort reports it. -->
      <body name="arm_carriage" pos="0.05 0 0.155">
        <joint name="gantry_slide" type="slide" axis="1 0 0" range="-0.26 0.26" damping="10.0" actuatorfrcrange="-80 80"/>
        <geom type="box" size="0.042 0.038 0.015" mass="0.35" rgba="0.9 0.45 0.1 1"/>

        <body name="arm_turret" pos="0 0 0.022">
          <joint name="arm_yaw" type="hinge" axis="0 0 1" range="-3.14 3.14" actuatorfrcrange="-15 15"/>
          <geom type="cylinder" size="0.03 0.018" mass="0.75" rgba="0.2 0.2 0.22 1"/>

          <body name="arm_upper" pos="0 0 0.018">
            <joint name="arm_shoulder" type="hinge" axis="0 1 0" range="-1.6 2.4" actuatorfrcrange="-30 30"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.34" size="0.019" mass="0.35" rgba="0.9 0.45 0.1 1"/>

            <body name="arm_forearm" pos="0 0 0.34">
              <joint name="arm_elbow" type="hinge" axis="0 1 0" range="-2.6 2.6" actuatorfrcrange="-15 15"/>
              <geom type="capsule" fromto="0 0 0 0.34 0 0" size="0.015" mass="0.30" rgba="0.25 0.25 0.28 1"/>

              <body name="arm_wrist" pos="0.34 0 0">
                <joint name="arm_wrist_pitch" type="hinge" axis="0 1 0" range="-2.0 2.0" actuatorfrcrange="-5 5"/>
                <!-- Palm + fingers sit 4 cm further out than the first design (palm 0.09 m, tip 0.105 m from
                     the wrist pivot): with the 0.065 m gripper a ground pick needed the shoulder ~10 deg below
                     horizontal, where the upper arm rests on its own gantry carriage (contact from 1.71 rad),
                     so the tip stopped short and high and the pads missed the crop. The longer gripper picks
                     a crop 0.62 m ahead at shoulder ~1.62 rad, clear of the carriage. -->
                <geom name="gripper_palm" type="box" pos="0.045 0 0" size="0.045 0.035 0.015" mass="0.15" rgba="0.9 0.45 0.1 1"/>
                <site name="gripper_tip" pos="0.105 0 0" size="0.008" rgba="1 0 0 1"/>
                <!-- Where gripper_tip was before the longer gripper (0.065 m from the wrist pivot). The RL balance
                     policy observes and is rewarded on this point (rl_balance_policy.POLICY_TIP_SITE), so
                     existing PPO policies see exactly the observation they were trained on. Invisible. -->
                <site name="policy_tip" pos="0.065 0 0" size="0.002" rgba="0 0 0 0"/>
                <!-- Wrist camera mount (matches camera_rig wrist_pos_body) and tool flange (load cell). -->
                <site name="wrist_cam" class="mount" pos="0.02 0 0.03"/>
                <site name="tool_flange" class="mount" pos="0.09 0 0"/>

                <body name="finger_left" pos="0.09 0.05 0">
                  <joint name="finger_left_joint" type="slide" axis="0 -1 0" range="0.0 0.04" damping="2.0"/>
                  <geom name="finger_left_pad" class="finger_pad" type="box" pos="0.03 0 0" size="0.035 0.005 0.012" mass="0.025" rgba="0.15 0.15 0.15 1"/>
                </body>
                <body name="finger_right" pos="0.09 -0.05 0">
                  <joint name="finger_right_joint" type="slide" axis="0 1 0" range="0.0 0.04" damping="2.0"/>
                  <geom name="finger_right_pad" class="finger_pad" type="box" pos="0.03 0 0" size="0.035 0.005 0.012" mass="0.025" rgba="0.15 0.15 0.15 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= 6 LOCOMOTION LEGS =================
           Per leg (moving mass 2.25 kg, DERIVED): hip body 1.85 kg = thigh motor + coaxial knee motor
           (2 x 0.85, CITED AK80-64 ~850 g; the knee is driven by a linkage/belt, no motor at the knee) + 0.15
           bracket (ASSUMED), with the motor CoM at the thigh joint; thigh link 0.25 kg CFRP/Al tube (ASSUMED);
           calf link 0.12 kg + rubber foot 0.03 kg (ASSUMED). Inertias are MuJoCo geometry-derived from these
           sub-geom masses. -->
      <!-- 1. Front-Right (FR) -->
      <body name="FR_hip" pos="0.26 -0.14 0">
        <joint name="FR_hip_joint" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="cylinder" fromto="0 0 0 0 -0.065 0" size="0.035" mass="0.15"/>
        <geom name="FR_knee_thigh_motors" class="mass_only" type="cylinder" fromto="0 -0.04 0 0 -0.09 0" size="0.045" mass="1.7"/>
        <body name="FR_thigh" pos="0 -0.065 0">
          <joint name="FR_thigh_joint" type="hinge" axis="0 1 0" range="-1.5 2.5"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.026" mass="0.25"/>
          <body name="FR_calf" pos="0 0 -0.23">
            <joint name="FR_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.021" mass="0.12" rgba="0.85 0.45 0.1 1"/>
            <geom name="FR_foot" type="sphere" pos="0 0 -0.23" size="0.03" mass="0.03" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

      <!-- 2. Front-Left (FL) -->
      <body name="FL_hip" pos="0.26 0.14 0">
        <joint name="FL_hip_joint" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="cylinder" fromto="0 0 0 0 0.065 0" size="0.035" mass="0.15"/>
        <geom name="FL_knee_thigh_motors" class="mass_only" type="cylinder" fromto="0 0.04 0 0 0.09 0" size="0.045" mass="1.7"/>
        <body name="FL_thigh" pos="0 0.065 0">
          <joint name="FL_thigh_joint" type="hinge" axis="0 1 0" range="-1.5 2.5"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.026" mass="0.25"/>
          <body name="FL_calf" pos="0 0 -0.23">
            <joint name="FL_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.021" mass="0.12" rgba="0.85 0.45 0.1 1"/>
            <geom name="FL_foot" type="sphere" pos="0 0 -0.23" size="0.03" mass="0.03" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

      <!-- 3. Middle-Right (MR) -->
      <body name="MR_hip" pos="0.0 -0.15 0">
        <joint name="MR_hip_joint" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="cylinder" fromto="0 0 0 0 -0.065 0" size="0.035" mass="0.15"/>
        <geom name="MR_knee_thigh_motors" class="mass_only" type="cylinder" fromto="0 -0.04 0 0 -0.09 0" size="0.045" mass="1.7"/>
        <body name="MR_thigh" pos="0 -0.065 0">
          <joint name="MR_thigh_joint" type="hinge" axis="0 1 0" range="-1.5 2.5"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.026" mass="0.25"/>
          <body name="MR_calf" pos="0 0 -0.23">
            <joint name="MR_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.021" mass="0.12" rgba="0.85 0.45 0.1 1"/>
            <geom name="MR_foot" type="sphere" pos="0 0 -0.23" size="0.03" mass="0.03" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

      <!-- 4. Middle-Left (ML) -->
      <body name="ML_hip" pos="0.0 0.15 0">
        <joint name="ML_hip_joint" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="cylinder" fromto="0 0 0 0 0.065 0" size="0.035" mass="0.15"/>
        <geom name="ML_knee_thigh_motors" class="mass_only" type="cylinder" fromto="0 0.04 0 0 0.09 0" size="0.045" mass="1.7"/>
        <body name="ML_thigh" pos="0 0.065 0">
          <joint name="ML_thigh_joint" type="hinge" axis="0 1 0" range="-1.5 2.5"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.026" mass="0.25"/>
          <body name="ML_calf" pos="0 0 -0.23">
            <joint name="ML_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.021" mass="0.12" rgba="0.85 0.45 0.1 1"/>
            <geom name="ML_foot" type="sphere" pos="0 0 -0.23" size="0.03" mass="0.03" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

      <!-- 5. Rear-Right (RR) -->
      <body name="RR_hip" pos="-0.26 -0.14 0">
        <joint name="RR_hip_joint" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="cylinder" fromto="0 0 0 0 -0.065 0" size="0.035" mass="0.15"/>
        <geom name="RR_knee_thigh_motors" class="mass_only" type="cylinder" fromto="0 -0.04 0 0 -0.09 0" size="0.045" mass="1.7"/>
        <body name="RR_thigh" pos="0 -0.065 0">
          <joint name="RR_thigh_joint" type="hinge" axis="0 1 0" range="-1.5 2.5"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.026" mass="0.25"/>
          <body name="RR_calf" pos="0 0 -0.23">
            <joint name="RR_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.021" mass="0.12" rgba="0.85 0.45 0.1 1"/>
            <geom name="RR_foot" type="sphere" pos="0 0 -0.23" size="0.03" mass="0.03" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

      <!-- 6. Rear-Left (RL) -->
      <body name="RL_hip" pos="-0.26 0.14 0">
        <joint name="RL_hip_joint" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="cylinder" fromto="0 0 0 0 0.065 0" size="0.035" mass="0.15"/>
        <geom name="RL_knee_thigh_motors" class="mass_only" type="cylinder" fromto="0 0.04 0 0 0.09 0" size="0.045" mass="1.7"/>
        <body name="RL_thigh" pos="0 0.065 0">
          <joint name="RL_thigh_joint" type="hinge" axis="0 1 0" range="-1.5 2.5"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.026" mass="0.25"/>
          <body name="RL_calf" pos="0 0 -0.23">
            <joint name="RL_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.23" size="0.021" mass="0.12" rgba="0.85 0.45 0.1 1"/>
            <geom name="RL_foot" type="sphere" pos="0 0 -0.23" size="0.03" mass="0.03" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Test Produce Item on Ground in front of robot (0.15 kg sphere r 0.035: ground placeholder).
         condim 6 + rolling friction 0.02: the 200 mm free-rolling drift drops to 2.5 mm (MEASURED, contact
         audit c98754d). Friction 0.8 / 0.05 / 0.02 ASSUMED. -->
    <body name="crop_item_1" pos="0.62 0.0 0.035">
      <freejoint name="crop_freejoint"/>
      <geom type="sphere" size="0.035" mass="0.15" rgba="0.9 0.15 0.15 1" condim="6" friction="0.8 0.05 0.02"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Dorsal Gantry & Arm Actuators (Indices 0..6) -->
    <!-- gantry_slide: kp 2000 / kv 60, +-80 N (ASSUMED belt drive; removes the 19 mm slide under 2 kg, MEASURED). -->
    <position name="gantry_slide" joint="gantry_slide" kp="2000" kv="60" ctrlrange="-0.26 0.26" forcerange="-80 80"/>
    <!-- arm_yaw: RMD-X8-25 class (CITED peak 25 / rated 10 Nm), +-15 Nm. -->
    <position name="arm_yaw" joint="arm_yaw" kp="150" kv="6" ctrlrange="-3.14 3.14" forcerange="-15 15"/>
    <!-- arm_shoulder: RMD-X8-25 / GO-M8010 class (GO-M8010-6 CITED max 23.7 Nm, so X8-25-class peak), +-30 Nm.
         MEASURED need 18.07 Nm at full reach with 2 kg (mass-load M10). -->
    <position name="arm_shoulder" joint="arm_shoulder" kp="300" kv="8" ctrlrange="-1.6 2.4" forcerange="-30 30"/>
    <!-- arm_elbow: +-15 Nm (MEASURED need 9.7 Nm with 2 kg). -->
    <position name="arm_elbow" joint="arm_elbow" kp="250" kv="6" ctrlrange="-2.6 2.6" forcerange="-15 15"/>
    <!-- arm_wrist_pitch: Dynamixel XM540-W270 class (CITED 10.6 Nm stall at 12 V), +-5 Nm. -->
    <position name="arm_wrist_pitch" joint="arm_wrist_pitch" kp="100" kv="3" ctrlrange="-2.0 2.0" forcerange="-5 5"/>
    <!-- Fingers (unchanged): kp 400 squeezes a 7 cm crop with ~12 N per pad - 10x the crop's weight in friction. -->
    <position name="finger_left" joint="finger_left_joint" kp="400" kv="4" ctrlrange="0.0 0.04" forcerange="-25 25"/>
    <position name="finger_right" joint="finger_right_joint" kp="400" kv="4" ctrlrange="0.0 0.04" forcerange="-25 25"/>

    <!-- 18 Leg Actuators (Indices 7..24), class leg_motor (AK80-64 class, see default) -->
