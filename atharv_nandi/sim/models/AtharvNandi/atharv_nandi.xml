<mujoco model="AtharvNandi">
  <!-- Physics alignment v1 (orchard target, 2026-11-17). Every physical number below carries a tag:
       MEASURED (headless run, tools/physics/*), CITED (source), DERIVED (arithmetic shown) or ASSUMED.
       Mass budget (DERIVED, kg): trunk body 15.45 + gantry carriage 0.35 = 15.8; dorsal basket 0.9;
       arm chain after the carriage 1.6; 6 legs x 2.25 = 13.5. Total 31.8 (= atharv_nandi_v1.xml).
       WP1 joint-less additions +2.585 (crown mast system 2.325 incl. beacon, rack 0.12, tray/cradle 0.040, bumper,
       belly rests, e-stop heads, marks, antennas, ballast; table in the WP1 contract notes; ORCHARD-MVP-SPEC 2.6
       budget mast <= 2.4 + rack/beacon/bumper/tray 0.2 = 2.6). Total 34.385.
       qpos layout is frozen: robot qpos[0:32], crop_item_1 at qpos[32:39]; ctrl order == qpos[7:32]. -->
  <compiler angle="radian" autolimits="true"/>
  <!-- cone elliptic + impratio 10: friction no longer drives normal penetration; same cost as pyramidal
       (MEASURED 45 vs 46 us/step, contact audit c98754d). timestep 0.002 is the default; 0.004 only via
       NANDI_DT (farm_scene) for STANDING / stop-and-shoot scans: walking at 0.004 is not gated (MEASURED 10 kg flat
       walk 2 calf-floor ticks, turn up to 10.1 mm foot penetration; 0 ticks at 0.002; review F6). -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <!-- Joint damping 1.5 Nm.s/rad: ASSUMED. Armature 0.02 kg.m^2: ASSUMED.
         TODO(armature): set to rotor_inertia * N^2 once the AK80-64 datasheet rotor inertia is obtained. -->
    <joint damping="1.5" armature="0.02"/>
    <!-- Friction 0.8 / 0.02 / 0.01: ASSUMED dry orchard soil against rubber. -->
    <geom friction="0.8 0.02 0.01" rgba="0.2 0.55 0.25 1"/>
    <!-- WP1 (ORCHARD-MVP-SPEC 2.5 ray groups; MVP-SPEC 2.4): every visible robot geom is in geom group 2 and
         every mass-only robot geom in group 5, so the safety rays {0, 1} and the coverage rays {0, 1, 3} pass
         through the robot. Applied as childclass of the trunk; the classes below that robot geoms name
         explicitly inherit it. World geoms keep group 0 (ground) and 1 (produce). Group 2 is visible by
         default, so the viewer and the browser draw the same robot geoms as before (plus the WP1 additions). -->
    <default class="robot">
      <geom group="2"/>
      <!-- Mass-only sub-geoms (motors, battery, electronics): no collision, so the contact set is unchanged.
           Group 2 (robot) with alpha 0 (was group 3): ORCHARD-MVP-SPEC 2.5 gives group 3 to foliage (coverage rays
           {0, 1, 3} hit it) and group 5 to query-only world geoms (foliage envelope, rope lines: crown strike and
           alley clearance), so a hidden motor in either would be a false hit. Group 2 is the robot group that safety
           and coverage masks already exclude; alpha 0 keeps them out of the viewer, the browser scene (web_scene
           skips alpha 0) and the wind drag (wind_model skips alpha 0). Not in groups 0/1. -->
      <default class="mass_only">
        <geom contype="0" conaffinity="0" group="2" rgba="0.1 0.1 0.12 0"/>
      </default>
      <!-- Finger pads: stiff, high-priority contact so a pinched crop does not creep out of the grip.
           With MuJoCo's default soft contact (solimp 0.9 0.95) friction is regularised and a 7 cm crop
           slid down through the pads at ~8 cm/s regardless of grip force, falling out mid-carry.
           priority=1 makes these params win over the crop's; solimp 0.995 cuts the creep to < 1 mm/s. -->
      <default class="finger_pad">
        <geom priority="1" solref="0.005 1" solimp="0.995 0.999 0.001" friction="1.2 0.02 0.01"/>
      </default>
      <!-- Basket floor and walls: stiff contact so a resting crop does not sink or creep (contact audit). -->
      <default class="basket">
        <geom solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.85 0.65 0.2 1"/>
      </default>
      <!-- WP1 joint-less additions that must never push anything: crown mast, ring, crown head, rack,
           beacon, e-stop heads, lift-point marks, antennas. contype 0 / conaffinity 0 (OS 2.3: no contact
           impulse from the mast or the head can reach the robot; strikes are geometric, WP24). -->
      <default class="wp1_nc">
        <geom contype="0" conaffinity="0" rgba="0.55 0.57 0.6 1"/>
      </default>
      <!-- WP1 desap tray cells, compartment divider and papaya cradle pads: contype 0, conaffinity 4
           ("tray bit"). A fruit collides with them only if its contype has bit 4 set (WP3 sets it on the
           fruit it places); the legacy crops (contype 1) and the arm (contype 1) pass through, so the legacy
           drop into the left channel is unchanged. -->
      <default class="tray">
        <geom contype="0" conaffinity="4" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.92 0.9 0.82 1"/>
      </default>
    </default>
    <!-- Leg actuator class: AK80-64 (CITED: rated 48 Nm, peak 120 Nm, rated speed ~4.2-5.0 rad/s;
         store.tmotor.com goods-1202, robotshop cubemars ak80-64, 2026-11-17). Position servo kp 300 / kv 6:
         removes the 34-48 mm tripod sag of kp 120 (MEASURED mass-load M14) and is above the kp 240 that held a
         3 m mast at 10 deg nose-up (MEASURED mounting H). forcerange +-100: peak derated from 120 (DERIVED).
         The 5 rad/s speed cap is a target rate limit in controllers/tripod_gait.py (a position actuator
         cannot cap velocity); the 48 Nm continuous limit is reported (RMS), not clamped.
         Upgrade path: kp 480 / kv 8 (saturates 10-38 % of samples at fr 48, MEASURED mass-load). -->
    <default class="leg_motor">
      <position kp="300" kv="6" ctrlrange="-2.8 2.8" forcerange="-100 100"/>
    </default>
    <!-- Invisible mount / sensor sites (alpha 0). -->
    <default class="mount">
      <site size="0.006" rgba="1 1 1 0"/>
    </default>
  </default>

  <asset>
    <texture type="2d" name="farm_soil" builtin="checker" width="512" height="512" rgb1="0.24 0.18 0.12" rgb2="0.28 0.21 0.14"/>
    <material name="soil_mat" texture="farm_soil" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.95 0.95 0.9"/>
    <!-- solref 0.01 1: hard orchard ground (MEASURED 0.70 mm standing penetration with elliptic cones). -->
    <geom name="floor" type="plane" size="25 25 0.1" material="soil_mat" solref="0.01 1"/>

    <!-- Uneven Farm Terrain Test Bumps -->
    <geom name="ridge_1" type="box" pos="1.4 0 0.02" size="0.15 1.5 0.02" rgba="0.3 0.22 0.15 1"/>
    <geom name="ridge_2" type="box" pos="2.2 0 0.03" size="0.18 1.5 0.03" rgba="0.3 0.22 0.15 1"/>

    <!-- Main Hexapod Chassis FIRST so qpos[0..6] is trunk root -->
    <body name="trunk" pos="0 0 0.34" childclass="robot">
      <freejoint name="root"/>
      <!-- Frame / shell 5.0 kg (ASSUMED), the collision box of the trunk. -->
      <geom name="trunk_geom" type="box" size="0.34 0.14 0.05" mass="5.0" rgba="0.14 0.28 0.16 1"/>
      <!-- 6 hip-abduction motors on the trunk at the hip mounts, 0.85 kg each (CITED AK80-64 ~850 g; listings
           disagree, 1.5 kg also seen). 6 x 0.85 = 5.1 kg (DERIVED). -->
      <geom name="FR_hipabd_motor" class="mass_only" type="cylinder" pos="0.26 -0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="FL_hipabd_motor" class="mass_only" type="cylinder" pos="0.26 0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="MR_hipabd_motor" class="mass_only" type="cylinder" pos="0.0 -0.105 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="ML_hipabd_motor" class="mass_only" type="cylinder" pos="0.0 0.105 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="RR_hipabd_motor" class="mass_only" type="cylinder" pos="-0.26 -0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <geom name="RL_hipabd_motor" class="mass_only" type="cylinder" pos="-0.26 0.095 0" euler="0 1.5708 0" size="0.045 0.025" mass="0.85"/>
      <!-- Battery 3.2 kg: 500 Wh Li-ion at ~155 Wh/kg pack (ASSUMED), low and forward so the home CoM sits over
           the 6-foot support centroid (spec: |CoM x - centroid x| <= 0.010 m).
           WP1: moved forward from x 0.06 to 0.11 to keep that rule after the 2.3 kg crown mast at x -0.30
           (MEASURED home CoM x -0.0072 m vs foot centroid 0.0; without the move -0.0118, rule broken). The rough
           clod walks of AT3 are sensitive to this placement (MEASURED: x 0.09-0.11 pass every AT3 gate; 0.08
           and 0.13 slow rough seeds 2/6 below the 0.20 m/s floor), so 0.11 is the chosen point, not a free knob.
           Electronics raised from z 0.0 to 0.025 so the two boxes do not overlap. -->
      <geom name="battery" class="mass_only" type="box" pos="0.11 0 -0.025" size="0.10 0.07 0.022" mass="3.2"/>
      <!-- Compute + electronics 1.5 kg (ASSUMED). -->
      <geom name="electronics" class="mass_only" type="box" pos="0.10 0 0.025" size="0.07 0.06 0.02" mass="1.5"/>

      <!-- Mount sites (body trunk). B owns the ratings table (controllers/load_model.py). -->
      <site name="imu" class="mount" pos="0 0 0"/>
      <site name="head_cam" class="mount" pos="0.35 0 0.06"/>
      <site name="mast_base" class="mount" pos="0.03 0 0.05"/>
      <site name="front_mount" class="mount" pos="0.34 0 0"/>
      <site name="rear_mount" class="mount" pos="-0.34 0 0"/>
      <site name="tow_dock" class="mount" pos="-0.34 0 -0.03"/>

      <!-- ================= WP1 joint-less robot additions (ORCHARD-MVP-SPEC 2.3-2.6, MVP-SPEC 2.5) =================
           Contract: WP1. No joint, no actuator: nq, nv and nu are those of atharv_nandi_v1.xml.
           Mass added (ASSUMED component masses, DERIVED sums, kg): crown mast system 2.295 (fixed 1.495 = drive 0.40
           + outer tube 0.35 + ring with 4 cameras and LiDAR 0.745; moving 0.80 = sections 0.15 + 0.13 + 0.12 +
           crown head 0.40) + beacon 0.03 = 2.325 on the mast; rack 0.12; bumper 0.03; belly rests 0.04; e-stop heads
           0.016; lift-point marks 0.008; antennas 0.005; tray + divider + cradle 0.040; ballast 0.001. Sum 2.585
           (cap 2.6, OS 2.6).
           Note: the trunk SITE "mast_base" at (0.03, 0, 0.05) is the physics-alignment v1 mount site of the
           NANDI_MAST_H mock and of load_model's mast_base rating; the crown mast is the BODY "mast_base" below. -->

      <!-- Crown mast (OS 2.3). Mount at trunk (-0.30, 0, 0.05): world z 0.39 at the home pose (trunk 0.34). -->
      <body name="mast_base" pos="-0.30 0 0.05">
        <geom name="mast_drive" class="wp1_nc" type="box" pos="0 0 0.03" size="0.04 0.04 0.03" mass="0.40" rgba="0.25 0.25 0.27 1"/>
        <!-- Outer tube: cylinder r 0.022, mast-local z 0.06-0.67 (world 0.45-1.06 at home). -->
        <geom name="mast_outer" class="wp1_nc" type="cylinder" pos="0 0 0.365" size="0.022 0.305" mass="0.35"/>
        <!-- Fixed ring at mast-local 0.595: lens 0.985 m at the keyframe, 0.978 m standing (the trunk settles
             7 mm, MEASURED), so 0.98 +- 0.01 holds in both (MVP-SPEC 2.4): 4 cameras at yaw 0/90/180/270, 25 deg down,
             fovy 83.6 deg (100 deg HFOV at 4:3), plus the mast LiDAR origin. -->
        <geom name="mast_ring" class="wp1_nc" type="cylinder" pos="0 0 0.595" size="0.06 0.04" mass="0.745" rgba="0.12 0.12 0.13 1"/>
        <camera name="ring_0" pos="0.062 0 0.595" xyaxes="0 -1 0 0.4226 0 0.9063" fovy="83.6"/>
        <camera name="ring_1" pos="0 0.062 0.595" xyaxes="1 0 0 0 0.4226 0.9063" fovy="83.6"/>
        <camera name="ring_2" pos="-0.062 0 0.595" xyaxes="0 1 0 -0.4226 0 0.9063" fovy="83.6"/>
        <camera name="ring_3" pos="0 -0.062 0.595" xyaxes="-1 0 0 0 -0.4226 0.9063" fovy="83.6"/>
        <site name="mast_lidar" class="mount" pos="0 0 0.595"/>
        <!-- Beacon: ring lamp on the outer tube just above the camera ring (world 1.028-1.052), visible from every
             side. rgba is written by sim/hooks/beacon.py; amber at rest. -->
        <geom name="beacon" class="wp1_nc" type="cylinder" pos="0 0 0.65" size="0.032 0.012" mass="0.03" rgba="1.0 0.62 0.05 1"/>
        <site name="mast_top" class="mount" pos="0 0 0.67"/>
        <!-- Three nested joint-free sections, s1 contains s2 contains s3. Each moves ext/3 along +z relative to its
             parent by a body_pos write (WP24); at rest body_pos = 0 (stowed). Capsules mast-local z 0.05-0.65
             (+ r): stowed world 0.42-1.06, inside the outer tube. Fully up (ext 1.60): overlap 0.087 m tube/s1 and
             0.067 m s1/s2, s2/s3. contype 0 (class wp1_nc). -->
        <body name="mast_s1" pos="0 0 0">
          <geom name="mast_s1_g" class="wp1_nc" type="capsule" fromto="0 0 0.05 0 0 0.65" size="0.018" mass="0.15" rgba="0.72 0.73 0.75 1"/>
          <body name="mast_s2" pos="0 0 0">
            <geom name="mast_s2_g" class="wp1_nc" type="capsule" fromto="0 0 0.05 0 0 0.65" size="0.015" mass="0.13" rgba="0.78 0.79 0.81 1"/>
            <body name="mast_s3" pos="0 0 0">
              <geom name="mast_s3_g" class="wp1_nc" type="capsule" fromto="0 0 0.05 0 0 0.65" size="0.012" mass="0.12" rgba="0.84 0.85 0.87 1"/>
              <site name="mast_s3_top" class="mount" pos="0 0 0.65"/>
              <!-- Crown head: box half-size 0.06, contype 0 / conaffinity 0. Body origin = lens: 1.10 m stowed,
                   1.10 + ext at extension ext (2.70 m at 1.60). Box bottom sits on the tube top (world 1.06). -->
              <body name="crown_head" pos="0 0 0.71">
                <geom name="crown_head_g" class="wp1_nc" type="box" pos="0 0 0.02" size="0.06 0.06 0.06" mass="0.36" rgba="0.15 0.16 0.18 1"/>
                <!-- Crown camera: 320 x 240 in the perception model, fovy 60 deg, looking along trunk +x level;
                     the gimbal is virtual (WP24/WP5 write cam_quat). -->
                <camera name="crown_cam" pos="0.062 0 0" xyaxes="0 -1 0 0 0 1" fovy="60"/>
                <site name="crown_ref" class="mount" pos="0 0 0"/>
                <!-- Anemometer (wind at crown height, WP7) and the GNSS-RTK antenna (MVP-SPEC 2.5: on the mast head). -->
                <geom name="anemometer_g" class="wp1_nc" type="cylinder" pos="0 0.035 0.105" size="0.012 0.025" mass="0.02" rgba="0.85 0.85 0.85 1"/>
                <site name="anemometer" class="mount" pos="0 0.035 0.13"/>
                <geom name="gnss_puck" class="wp1_nc" type="cylinder" pos="0 -0.025 0.088" size="0.03 0.008" mass="0.02" rgba="0.9 0.9 0.88 1"/>
                <site name="gnss_antenna" class="mount" pos="0 -0.025 0.096"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Tool rack (OS 2.4, WP0c feasibility-report 5.5): 3 cradles on one rail on the trunk's right side,
           rail at trunk y -0.17, z +0.26; cradle points x -0.15 (T2 CLIPPER), 0.00 (T4 TWIST), +0.15 (T5 PRUNER).
           Posts at x +-0.13 stand clear of the hip motors (x 0 and +-0.26, r 0.045). 0.12 kg (ASSUMED). -->
      <geom name="rack_foot_f" class="wp1_nc" type="box" pos="0.13 -0.152 0.056" size="0.012 0.022 0.006" mass="0.005"/>
      <geom name="rack_foot_r" class="wp1_nc" type="box" pos="-0.13 -0.152 0.056" size="0.012 0.022 0.006" mass="0.005"/>
      <geom name="rack_post_f" class="wp1_nc" type="box" pos="0.13 -0.170 0.162" size="0.008 0.008 0.100" mass="0.015"/>
      <geom name="rack_post_r" class="wp1_nc" type="box" pos="-0.13 -0.170 0.162" size="0.008 0.008 0.100" mass="0.015"/>
      <geom name="rack_rail" class="wp1_nc" type="box" pos="0 -0.170 0.270" size="0.20 0.012 0.010" mass="0.050"/>
      <geom name="rack_cradle_0" class="wp1_nc" type="box" pos="-0.15 -0.180 0.240" size="0.035 0.012 0.020" mass="0.010" rgba="0.2 0.2 0.25 1"/>
      <geom name="rack_cradle_1" class="wp1_nc" type="box" pos="0.00 -0.180 0.240" size="0.035 0.012 0.020" mass="0.010" rgba="0.2 0.2 0.25 1"/>
      <geom name="rack_cradle_2" class="wp1_nc" type="box" pos="0.15 -0.180 0.240" size="0.035 0.012 0.020" mass="0.010" rgba="0.2 0.2 0.25 1"/>
      <site name="cradle_T2" class="mount" pos="-0.15 -0.17 0.26"/>
      <site name="cradle_T4" class="mount" pos="0.00 -0.17 0.26"/>
      <site name="cradle_T5" class="mount" pos="0.15 -0.17 0.26"/>

      <!-- Front bumper (MVP-SPEC 2.5): thin box ahead of the trunk front face, collidable, with a touch sensor
           (sensor "bumper"). It sits at trunk z -0.045..0.005 (world 0.295-0.345), above the legacy crops. -->
      <geom name="bumper" type="box" pos="0.352 0 -0.02" size="0.010 0.12 0.025" mass="0.03" rgba="0.1 0.1 0.1 1"/>
      <site name="bumper_touch" class="mount" type="box" pos="0.352 0 -0.02" size="0.014 0.124 0.029"/>

      <!-- Belly rests (MVP-SPEC 2.5 e-stop sit-down): 4 rubber pads under the trunk, collidable with the ground,
           12 mm below the trunk box (world 0.278 at the home pose). Support polygon x +-0.215, y +-0.105. -->
      <geom name="belly_rest_fl" type="box" pos="0.18 0.07 -0.056" size="0.035 0.035 0.006" mass="0.01" rgba="0.08 0.08 0.08 1"/>
      <geom name="belly_rest_fr" type="box" pos="0.18 -0.07 -0.056" size="0.035 0.035 0.006" mass="0.01" rgba="0.08 0.08 0.08 1"/>
      <geom name="belly_rest_rl" type="box" pos="-0.18 0.07 -0.056" size="0.035 0.035 0.006" mass="0.01" rgba="0.08 0.08 0.08 1"/>
      <geom name="belly_rest_rr" type="box" pos="-0.18 -0.07 -0.056" size="0.035 0.035 0.006" mass="0.01" rgba="0.08 0.08 0.08 1"/>

      <!-- Marked lift points (two-person lift / recovery after a fall): yellow marks on both side faces, between
           the hips, plus a site each. -->
      <geom name="lift_mark_fl" class="wp1_nc" type="box" pos="0.13 0.1405 0" size="0.02 0.0015 0.02" mass="0.002" rgba="1 0.85 0 1"/>
      <geom name="lift_mark_fr" class="wp1_nc" type="box" pos="0.13 -0.1405 0" size="0.02 0.0015 0.02" mass="0.002" rgba="1 0.85 0 1"/>
      <geom name="lift_mark_rl" class="wp1_nc" type="box" pos="-0.13 0.1405 0" size="0.02 0.0015 0.02" mass="0.002" rgba="1 0.85 0 1"/>
      <geom name="lift_mark_rr" class="wp1_nc" type="box" pos="-0.13 -0.1405 0" size="0.02 0.0015 0.02" mass="0.002" rgba="1 0.85 0 1"/>
      <site name="lift_point_fl" class="mount" pos="0.13 0.142 0"/>
      <site name="lift_point_fr" class="mount" pos="0.13 -0.142 0"/>
      <site name="lift_point_rl" class="mount" pos="-0.13 0.142 0"/>
      <site name="lift_point_rr" class="mount" pos="-0.13 -0.142 0"/>

      <!-- E-stop mushroom heads (MVP-SPEC 2.5) on both side faces near the rear, where a person beside the robot
           reaches them. Visual only: in the sim the press is the console E-STOP, the phone button or the handheld. -->
      <geom name="estop_l" class="wp1_nc" type="cylinder" pos="-0.19 0.147 0.015" euler="1.5708 0 0" size="0.022 0.007" mass="0.008" rgba="0.85 0.05 0.05 1"/>
      <geom name="estop_r" class="wp1_nc" type="cylinder" pos="-0.19 -0.147 0.015" euler="1.5708 0 0" size="0.022 0.007" mass="0.008" rgba="0.85 0.05 0.05 1"/>
      <site name="estop" class="mount" pos="-0.19 0 0.015"/>

      <!-- Handheld e-stop receiver (OS 1.1: wireless handheld for the field supervisor, local safety link) and
           its antenna at the rear-left corner. The input itself is the /nandi/handheld_estop topic
           (sim/hooks/beacon.py), independent of the console. -->
      <geom name="handheld_rx_antenna" class="wp1_nc" type="capsule" fromto="-0.33 0.10 0.05 -0.33 0.10 0.13" size="0.004" mass="0.005" rgba="0.1 0.1 0.1 1"/>
      <site name="handheld_estop_rx" class="mount" pos="-0.33 0.10 0.13"/>

      <!-- Full-Length Top Cargo Basket (0.64m long x 0.24m wide, clear of all 6 legs), 0.9 kg -->
      <body name="dorsal_basket" pos="0 0 0.055">
        <geom name="basket_floor" class="basket" type="box" pos="0 0 0" size="0.32 0.12 0.006" mass="0.4"/>
        <geom name="basket_front" class="basket" type="box" pos="0.314 0 0.035" size="0.006 0.12 0.035" mass="0.1"/>
        <geom name="basket_rear" class="basket" type="box" pos="-0.314 0 0.035" size="0.006 0.12 0.035" mass="0.1"/>
        <geom name="basket_left_wall" class="basket" type="box" pos="0 0.114 0.035" size="0.32 0.006 0.035" mass="0.15"/>
        <geom name="basket_right_wall" class="basket" type="box" pos="0 -0.114 0.035" size="0.32 0.006 0.035" mass="0.15"/>
        <!-- Payload CoM reference: trunk z 0.096 = floor top 0.061 + half of the 0.07 wall (DERIVED). -->
        <site name="basket_payload" class="mount" pos="0 0 0.041"/>

        <!-- ===== WP1: desap cell tray (front) + papaya cradle (rear), OS 2.4 "Basket" =====
             Basket frame (trunk z +0.055); floor top at basket z 0.006 (trunk 0.061). The gantry rail runs over
             the centreline at basket z 0.070-0.090, so the cells sit in the two side lanes between the rail
             (|y| < 0.022) and the walls (|y| > 0.108): 2 lanes x 4 cells, pitch 0.0888 m (x) x 0.086 m (y),
             one fruit per cell, stalk-down, nothing below it. Cells fit fruit up to ~8 cm across (Amrapali HDP
             mango, guava; ASSUMED). Divider walls 0.040 m high (ASSUMED). Class "tray": conaffinity 4 only.
             Shade cover: not modelled (it would sit in the arm's drop path; fidelity register). -->
        <geom name="basket_divider" class="tray" type="box" pos="-0.050 0 0.026" size="0.003 0.108 0.020" mass="0.008"/>
        <geom name="tray_lane_wall_l" class="tray" type="box" pos="0.1305 0.022 0.026" size="0.1775 0.002 0.020" mass="0.006"/>
