              <geom type="capsule" fromto="0 0 0 0.34 0 0" size="0.015" mass="0.30" rgba="0.25 0.25 0.28 1"/>

              <body name="arm_wrist" pos="0.34 0 0">
                <joint name="arm_wrist_pitch" type="hinge" axis="0 1 0" range="-2.0 2.0" actuatorfrcrange="-5 5"/>
                <!-- Palm + fingers sit 4 cm further out than the first design (palm 0.09 m, tip 0.105 m from
                     the wrist pivot): with the 0.065 m gripper a ground pick needed the shoulder ~10 deg below
                     horizontal, where the upper arm rests on its own gantry carriage (contact from 1.71 rad),
                     so the tip stopped short and high and the pads missed the crop. The longer gripper picks
                     a crop 0.62 m ahead at shoulder ~1.62 rad, clear of the carriage. -->
                <geom name="gripper_palm" type="box" pos="0.045 0 0" size="0.045 0.035 0.015" mass="0.15" rgba="0.9 0.45 0.1 1"/>
                <site name="gripper_tip" pos="0.105 0 0" size="0.008" rgba="1 0 0 1"/>
                <!-- Where gripper_tip was before the longer gripper (0.065 m from the wrist pivot). The RL balance
                     policy observes and is rewarded on this point (rl_balance_policy.POLICY_TIP_SITE), so
                     existing PPO policies see exactly the observation they were trained on. Invisible. -->
                <site name="policy_tip" pos="0.065 0 0" size="0.002" rgba="0 0 0 0"/>
